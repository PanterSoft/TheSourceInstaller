{
  "$description": "TSI color identity (Forge Red). Source of truth for any TSI surface: docs site (docs/stylesheets/tsi.css), terminal (src/ui/palette.rs) and any future GUI. Format: W3C Design Tokens. Rules: docs/brand.md.",
  "brand": {
    "$type": "color",
    "forge-red": { "$value": "#C62828", "$description": "Primary. Header, logo, primary buttons." },
    "forge-red-deep": { "$value": "#8E1B1B", "$description": "Dark-mode header, pressed states." },
    "link-red": { "$value": "#B71C1C", "$description": "Links and red text on light backgrounds." },
    "ember": { "$value": "#FF6B5E", "$description": "Red on dark backgrounds." },
    "on-brand": { "$value": "#FFFFFF", "$description": "Text and icons on Forge Red." }
  },
  "neutral": {
    "$type": "color",
    "ash": { "$value": "#F7F4F3", "$description": "Warm light background." },
    "kiln": { "$value": "#1C1A1A", "$description": "Warm dark background." }
  },
  "status": {
    "$type": "color",
    "$description": "Semantic colors. Error is red like the brand, so an error is never shown by color alone: always pair it with an icon or a label.",
    "success-light": { "$value": "#2E7D32" },
    "success-dark": { "$value": "#57AB5A" },
    "warning-light": { "$value": "#9A5B00" },
    "warning-dark": { "$value": "#E0A43A" },
    "error-light": { "$value": "#B3261E" },
    "error-dark": { "$value": "#FF8A80" }
  },
  "theme": {
    "light": {
      "$type": "color",
      "background": { "$value": "{neutral.ash}" },
      "surface": { "$value": "#FFFFFF" },
      "text": { "$value": "#1C1A1A" },
      "primary": { "$value": "{brand.forge-red}" },
      "on-primary": { "$value": "{brand.on-brand}" },
      "link": { "$value": "{brand.link-red}" }
    },
    "dark": {
      "$type": "color",
      "background": { "$value": "{neutral.kiln}" },
      "surface": { "$value": "#272323" },
      "text": { "$value": "#E8E3E1" },
      "primary": { "$value": "{brand.forge-red-deep}" },
      "on-primary": { "$value": "{brand.on-brand}" },
      "link": { "$value": "{brand.ember}" }
    }
  },
  "terminal": {
    "$description": "xterm-256 indices; one set for dark and light terminals alike.",
    "brand": { "$type": "number", "$value": 167, "$description": "Terminal Red #D75F5F." },
    "on-brand": { "$type": "number", "$value": 231, "$description": "White, for text on Terminal Red." },
    "brand-deep": { "$type": "number", "$value": 131, "$description": "#AF5F5F, filled part of progress bars." },
    "track": { "$type": "number", "$value": 238, "$description": "#444444, unfilled part of progress bars." }
  }
}
